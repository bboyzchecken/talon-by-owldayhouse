# /opt/odh-internal/.env on the Droplet — NEVER committed.
# Read by docker compose. The api service gets all of it; the intake service
# gets only the INTAKE_* / TURNSTILE_* values named in docker-compose.yml.
#
# Create it once on the server:
#   install -m 600 /dev/null /opt/odh-internal/.env && nano /opt/odh-internal/.env

# The subdomain Caddy gets its certificate for.
ODH_DOMAIN=crm.owldayhouse.com

ENV=production
PORT=5000

# Browsers allowed to call the API. Same host as above, so the UI's
# same-origin requests pass.
CORS_ORIGINS=https://crm.owldayhouse.com

# JWT (HS256, 7-day tokens). Generate: openssl rand -base64 48
JWT_SECRET_KEY=
JWT_TTL_HOURS=168

# PostgreSQL. POSTGRES_HOST/PORT are set by docker-compose.yml.
POSTGRES_USERNAME=odh
POSTGRES_PASSWORD=
POSTGRES_DATABASE=odh_internal
POSTGRES_SSLMODE=disable
# Must stay well under the server's max_connections=25.
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME_MINUTES=30

# Cloudflare R2 — private buckets, presigned URLs only.
# Use an R2 API token scoped to these two buckets and nothing else.
R2_ENDPOINT=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_FILE_BUCKET=odh-internal-files
R2_BACKUP_BUCKET=odh-internal-backups
R2_PRESIGN_EXPIRY_MINUTES=15
R2_MAX_UPLOAD_MB=20

# Lead Tracker: the pg_trgm similarity above which a name is reported as
# "looks like an existing customer" (0-1).
LEAD_SIMILARITY_THRESHOLD=0.4

# ── Public intake (the quote form on owldayhouse.com) ───────────────────
# Off until every value below is filled in and the DNS record exists. Then
# uncomment this line and deploy: compose starts the intake service too.
# COMPOSE_PROFILES=intake

# Its own hostname. DNS: an A record for it pointing at this Droplet, grey
# cloud (DNS only) if the zone is on Cloudflare — see README.md.
# ODH_INTAKE_DOMAIN=api.owldayhouse.com

# The site origins allowed to post the form (comma-separated, no slash).
INTAKE_CORS_ORIGINS=https://owldayhouse.com,https://www.owldayhouse.com

# The password of the odh_intake database role. The API sets it on boot (the
# API reads it whether or not the profile is on) and
# grants that role INSERT on inbound_requests and nothing else.
# Generate: openssl rand -hex 24   (hex: no quotes or spaces to escape)
INTAKE_POSTGRES_PASSWORD=

# Key for hashing callers' IP addresses, so spam can be grouped without
# keeping anyone's address. Generate: openssl rand -hex 32
INTAKE_IP_SALT=

# Cloudflare Turnstile secret key (the site key goes in the web build, see
# apps/web). The intake refuses to start without it in production.
TURNSTILE_SECRET=
