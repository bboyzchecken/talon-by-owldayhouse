{
  "name": "odh-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "kill-port": "node scripts/kill-port.mjs 3000",
    "predev": "node scripts/kill-port.mjs 3000",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy:web": "pnpm build:web && bash infra/ftp-deploy/deploy.sh",
    "test": "turbo run test",
    "build:internal": "turbo run build --filter internal",
    "dev:internal": "turbo run dev --filter internal",
    "build:api": "turbo run build --filter api",
    "test:api": "turbo run test --filter api"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
