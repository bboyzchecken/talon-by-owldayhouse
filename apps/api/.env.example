# ODH internal tools API — copy to .env and fill in.
# NEVER commit the real .env (see .gitignore). On the Droplet this file lives
# at /opt/odh-internal/.env and is read by docker compose.
#
# There is deliberately NO mail configuration: this system never sends e-mail.

ENV=development
PORT=5000

# JWT (HS256, 7-day tokens). Generate with: openssl rand -base64 48
JWT_SECRET_KEY=
JWT_TTL_HOURS=168

# Browsers allowed to call the API (comma-separated, no trailing slash).
# Production: https://crm.owldayhouse.com
CORS_ORIGINS=http://localhost:3100

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=odh
POSTGRES_PASSWORD=
POSTGRES_DATABASE=odh_internal
POSTGRES_SSLMODE=disable
# Kept small: the API and Postgres share one 1 vCPU / 2 GB Droplet.
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME_MINUTES=30

# Cloudflare R2 — private buckets, presigned URLs only.
# Use an R2 API token scoped to these two buckets and nothing else.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_FILE_BUCKET=odh-internal-files
R2_BACKUP_BUCKET=odh-internal-backups
R2_PRESIGN_EXPIRY_MINUTES=15
R2_MAX_UPLOAD_MB=20

# Lead Tracker: the pg_trgm similarity above which a name is reported as
# "looks like an existing customer" (0-1). 0.4 keeps real near-misses in and
# unrelated Thai company names out.
LEAD_SIMILARITY_THRESHOLD=0.4
