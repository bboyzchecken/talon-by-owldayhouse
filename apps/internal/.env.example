# ODH internal tools UI.
#
# The API origin. Leave it EMPTY in production: Caddy serves this static app
# and reverse-proxies /api and /auth to the Go API on the same host, so
# same-origin relative requests are what we want.
#   production: NEXT_PUBLIC_API_URL=
#   local dev : NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
