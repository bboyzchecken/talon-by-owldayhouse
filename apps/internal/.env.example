# ODH internal tools UI.
#
# The API origin. It is baked into the bundle at BUILD time, so it has to be
# right when `next build` runs — setting it on the server changes nothing.
#   production: infra/digitalocean/deploy.sh exports
#               https://crm.owldayhouse.com before building, so every request
#               is same-origin (Caddy proxies /api and /auth to the Go API).
#   local dev : NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
