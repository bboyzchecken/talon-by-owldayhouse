# apps/web — copy to .env.local and fill in (never commit real values)

# Google Analytics 4 Measurement ID override. Unset → production builds use the
# default in components/Analytics.tsx (G-ZXV0J46ECG); dev loads no GA.
# NOTE: NEXT_PUBLIC_* is inlined at build time. Uncomment and leave empty to
# disable analytics in a production build.
# NEXT_PUBLIC_GA_ID=

# Base URL for the ODH Go API, consumed by @odh/query.
# Not used by this static marketing site; safe to leave empty here.
NEXT_PUBLIC_API_URL=

# The quote form on /contact/ (plan 5). Both are public by design and baked
# into the bundle at build time. The form is hidden unless both are set AND
# contact.replyWithinBusinessDays is a number in content/site.ts.
#   NEXT_PUBLIC_INTAKE_URL           e.g. https://api.owldayhouse.com (no trailing slash)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY   Cloudflare Turnstile *site* key (never the secret)
# For local testing Cloudflare's always-pass test key is 1x00000000000000000000AA.
NEXT_PUBLIC_INTAKE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
