# apps/web — copy to .env.local and fill in (never commit real values)

# Google Analytics 4 Measurement ID override. Unset → production builds use the
# default in components/Analytics.tsx (G-ZXV0J46ECG); dev loads no GA.
# NOTE: NEXT_PUBLIC_* is inlined at build time. Uncomment and leave empty to
# disable analytics in a production build.
# NEXT_PUBLIC_GA_ID=

# Base URL for the ODH Go API, consumed by @odh/query in the Talon dashboard.
# Not used by this static marketing site; safe to leave empty here.
NEXT_PUBLIC_API_URL=
